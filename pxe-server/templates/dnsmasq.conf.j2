interface={{ pxe_interface_name }}
bind-interfaces
enable-tftp
tftp-root={{ tftp_root }}

{% if pxe_proxy_dhcp | bool %}
dhcp-range={{ pxe_server_ip }},proxy
{% else %}
dhcp-range={{ pxe_dhcp_range_start }},{{ pxe_dhcp_range_end }},{{ pxe_netmask }},12h
dhcp-option=3,{{ pxe_gateway }}
dhcp-option=6,{{ pxe_dns }}
{% endif %}

dhcp-boot=pxelinux.0